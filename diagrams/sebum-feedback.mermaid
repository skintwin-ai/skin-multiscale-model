graph TB
    subgraph "Sebaceous Unit State Ξ^{sebaceous}"
        SU1[Sebocyte Population n̂_{sebocyte}]
        SU2[Lipid Synthesis Rate ∂c_{lipid}/∂t]
        SU3[Holocrine Secretion Flux J_{sebum}]
        SU4[Gland Volume V_{gland}(t)]
        SU5[Local ∇(androgen) Field]
    end
    
    subgraph "Molecular Regulation ∇_{sebum}Φ"
        M1[5α-Reductase Activity]
        M2[DHT Concentration ∇(DHT)]
        M3[PPARγ Activation State]
        M4[Lipogenic Enzyme Complex]
        M5[τ_{synthesis} ~ 10³ s]
    end
    
    subgraph "Cellular Dynamics Ψ_{sebocyte}"
        C1[Basal Cell Proliferation]
        C2[Differentiation → Lipid Loading]
        C3[Organelle Dissolution]
        C4[Holocrine Rupture Threshold Λ^{rupture}]
        C5[Cell Debris + Lipid Mix]
    end
    
    subgraph "Sebum Composition Tensor"
        SC1[Squalene: 12-15%]
        SC2[Wax Esters: 25-30%]
        SC3[Triglycerides → FFA]
        SC4[Cholesterol: 1-3%]
        SC5[Phase State: Liquid @ 32°C]
    end
    
    subgraph "Surface Integration ℰ^{sebum-barrier}"
        SI1[Sebum Film Formation]
        SI2[Mixing with Ξ^{lamellar}]
        SI3[∇(a_w) Modulation]
        SI4[Antimicrobial Peptide Carrier]
        SI5[B_{eff} Surface Component]
    end
    
    subgraph "Microbiome Coupling Ĥ_{sebum-microbe}"
        MB1[C. acnes Lipase Activity]
        MB2[Triglyceride → FFA + Glycerol]
        MB3[pH Acidification ∇pH↓]
        MB4[Biofilm Matrix Component]
        MB5[Quorum Sensing Modulation]
    end
    
    subgraph "Feedback Control Loops"
        F1[Surface Lipid → Sebocyte Inhibition]
        F2[FFA → Inflammation → Hyperkeratinization]
        F3[∇pH → Microbiome Selection]
        F4[Oxidized Squalene → Comedogenesis]
        F5[Androgen → Positive Feedback]
    end
    
    subgraph "Emergent Steady States"
        SS1[Λ^{normal}: J_{sebum} = 1 μg/cm²/min]
        SS2[Λ^{oily}: J_{sebum} > 1.5]
        SS3[Λ^{dry}: J_{sebum} < 0.5]
        SS4[Λ^{acneic}: Positive Feedback Dominance]
    end
    
    subgraph "Formulation Interventions"
        FI1[Retinoids → ↓ Sebocyte Differentiation]
        FI2[Niacinamide → ↓ Sebum Production]
        FI3[Salicylic Acid → Comedolysis]
        FI4[Zinc → 5α-Reductase Inhibition]
    end
    
    SU1 --> M1
    M1 --> M2
    M2 --> M3
    M3 --> M4
    
    M4 --> C1
    C1 --> C2
    C2 --> C3
    C3 --> C4
    C4 --> C5
    
    C5 --> SC1
    C5 --> SC2
    C5 --> SC3
    C5 --> SC4
    SC1 --> SC5
    
    SC5 --> SI1
    SI1 --> SI2
    SI2 --> SI3
    SI3 --> SI4
    SI4 --> SI5
    
    SC3 --> MB1
    MB1 --> MB2
    MB2 --> MB3
    MB3 --> MB4
    MB4 --> MB5
    
    SI5 --> F1
    MB2 --> F2
    MB3 --> F3
    SC1 --> F4
    M2 --> F5
    
    F1 -.->|Negative| SU1
    F2 -.->|Positive| C1
    F3 -.->|Modulates| MB1
    F4 -.->|Triggers| F2
    F5 -.->|Amplifies| M1
    
    F1 --> SS1
    F5 --> SS2
    F1 --> SS3
    F2 --> SS4
    
    FI1 -.->|Blocks| C2
    FI2 -.->|Inhibits| M4
    FI3 -.->|Disrupts| F4
    FI4 -.->|Blocks| M1
    
    style SU1 fill:#fff3e0,stroke:#e65100,stroke-width:3px
    style C4 fill:#ffcdd2,stroke:#d32f2f,stroke-width:2px
    style SS1 fill:#c8e6c9,stroke:#2e7d32,stroke-width:3px
    style F2 fill:#ff9800,stroke:#e65100,stroke-width:3px